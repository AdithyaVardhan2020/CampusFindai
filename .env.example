# ==============================================================================
# CampusFind Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your actual .env file or database passwords to version control.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_random_key_here_for_sessions_and_csrf

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For local development without Aiven, leave DATABASE_URL empty to use SQLite:
# DATABASE_URL=

# For Aiven Cloud MySQL, enter your URI from the Aiven Console:
# Format: mysql+pymysql://<AVN_USER>:<AVN_PASSWORD>@<AVN_HOST>:<AVN_PORT>/<AVN_DB>?ssl_ca=<PATH_TO_CA>
# Example:
# DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@mysql-campusfind-xyz.aivencloud.com:12345/defaultdb

# Path to the downloaded Aiven CA certificate (ca.pem).
# Download from Aiven Console: Project > Service (MySQL) > Overview > "CA Certificate".
# Optional if already included in query parameters of DATABASE_URL.
# AIVEN_CA_CERT=C:\Users\Admin-pc\OneDrive\Documents\CampusFindAI\ca.pem
AIVEN_CA_CERT=

# ------------------------------------------------------------------------------
# AI OpenCLIP Image Matching Configuration
# ------------------------------------------------------------------------------
# OpenCLIP vision model name and pretrained weights:
# Supported models: ViT-B-32 (recommended balance of accuracy and CPU speed)
AI_MODEL_NAME=ViT-B-32
AI_PRETRAINED_SOURCE=openai

# Cosine similarity matching threshold (0.00 to 1.00).
# Suggested: 0.60 (60% similarity required to show up as a match suggestion)
AI_SIMILARITY_THRESHOLD=0.60

# Max match suggestions to display per report
AI_MAX_MATCHES=6

# ------------------------------------------------------------------------------
# File Upload Settings
# ------------------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
# Set to True in production when HTTPS is enabled
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
